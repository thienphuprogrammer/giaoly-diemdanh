# Chép thành .env.local rồi điền giá trị thật. KHÔNG commit .env.local. Kiểm tra bằng: pnpm preflight
# Hướng dẫn đầy đủ: docs/deploy-vercel-ios.md

# Postgres hosted (Neon / Supabase), PostgreSQL 15 trở lên. Trên mạng thì thêm ?sslmode=require
DATABASE_URL=postgres://user:password@host:5432/dbname
# openssl rand -base64 32
AUTH_SECRET=

# ---- Tuỳ chọn (bỏ dấu # để bật) ----

# Kết nối trực tiếp (không qua pooler) cho migration/seed; Neon: chuỗi không có "-pooler".
# DATABASE_URL_UNPOOLED=postgres://user:password@host:5432/dbname?sslmode=require
# Số kết nối tối đa mỗi instance (1–20, mặc định 5).
# DB_POOL_MAX=5
# Đặt false khi dùng pooler giao dịch của Supabase (cổng 6543).
# DB_PREPARE=false

# Chỉ bật nếu thật sự có iPhone iOS 15 trở xuống cần máy quét QR (làm yếu CSP). Đặt lúc build.
# CSP_ALLOW_UNSAFE_EVAL=1

# Thông báo đẩy: sinh cặp khoá bằng `pnpm push:keys` (in ra màn hình, không ghi tệp). Khoá riêng là bí mật.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:email-lien-he@ten-mien

# Nhắc việc tự động (/api/cron/nhac-viec) và dọn nhật ký 365 ngày: openssl rand -base64 48 (≥ 32 ký tự).
# CRON_SECRET=
