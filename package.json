{
  "name": "diemdanh-giaoly",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "db:migrate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "qr:wasm": "node scripts/copy-qr-wasm.mjs",
    "bench:baseline": "node --import tsx scripts/bench-baseline.ts",
    "test:pg": "vitest run --config vitest.pg.config.ts",
    "bench:scan": "node --import tsx scripts/bench-scan.ts",
    "bench:seed": "node --import tsx scripts/bench-seed.ts",
    "preflight": "node --env-file-if-exists=.env.local --import tsx scripts/preflight.ts",
    "push:keys": "node --import tsx scripts/push-keys.ts"
  },
  "dependencies": {
    "barcode-detector": "3.2.2",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "web-push": "3.6.7",
    "zod": "^4.6.5",
    "zxing-wasm": "3.1.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "3.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.32.1"
}
